    },
    "MigrationExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
          }
        ],
        "Policies": [
          {
            "PolicyName": "MigrationSecret",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": {
                    "Fn::GetAtt": [
                      "Database",
                      "MasterUserSecret.SecretArn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "MigrationTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Cpu": "512",
        "Memory": "1024",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "MigrationExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "TaskRole",
            "Arn"
          ]
        },
        "Volumes": [
          {
            "Name": "tmp"
          }
        ],
        "ContainerDefinitions": [
          {
            "Name": "migration",
            "Image": {
              "Ref": "MigrationImageUri"
            },
            "Essential": true,
            "ReadonlyRootFilesystem": true,
            "User": "1000:1000",
            "Command": [
              "node",
              "scripts/migrate.mjs"
            ],
            "Environment": [
              {
                "Name": "RENEWRELAY_ENV",
                "Value": {
                  "Ref": "Environment"
                }
              },
              {
                "Name": "PGHOST",
                "Value": {
                  "Fn::GetAtt": [
                    "Database",
                    "Endpoint.Address"
                  ]
                }
              },
              {
                "Name": "PGDATABASE",
                "Value": "renewrelay"
              },
              {
                "Name": "PGUSER",
                "Value": "renewrelay_migrator"
              }
            ],
            "Secrets": [
              {
                "Name": "PGPASSWORD",
                "ValueFrom": {
                  "Fn::Join": [
                    "",
                    [
                      {
                        "Fn::GetAtt": [
                          "Database",
                          "MasterUserSecret.SecretArn"
                        ]
                      },
                      ":password::"
                    ]
                  ]
                }
              }
            ],
            "MountPoints": [
              {
                "SourceVolume": "tmp",
                "ContainerPath": "/tmp",
                "ReadOnly": false
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "WebLogs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "app",
                "mode": "blocking"
              }
            }
          }
        ],
        "RuntimePlatform": {
          "CpuArchitecture": {
            "Ref": "CpuArchitecture"
          },
          "OperatingSystemFamily": "LINUX"
        }
      }
    }
  },
  "Outputs": {
    "OriginHost": {
      "Value": {
        "Fn::GetAtt": [
          "LoadBalancer",
          "DNSName"
        ]
      }
    },
    "DatabaseHost": {
      "Value": {
        "Fn::GetAtt": [
          "Database",
          "Endpoint.Address"
        ]
      }
    },
    "MigrationSecretArn": {
      "Value": {
        "Fn::GetAtt": [
          "Database",
          "MasterUserSecret.SecretArn"
        ]
      }
    },
    "AlertsTopicArn": {
      "Value": {
        "Ref": "Alerts"
      }
    },
    "ClusterName": {
      "Value": {
        "Ref": "Cluster"
      }
    },
    "MigrationTaskArn": {
      "Value": {
        "Ref": "MigrationTask"
      }
    }
  },
  "Conditions": {
    "StartApplication": {
      "Fn::Equals": [
        {
          "Ref": "ApplicationEnabled"
        },
        "true"
      ]
    }
  }
}
