{
  "name": "renewrelay",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/next/dist/bin/next dev apps/web",
    "build": "next build apps/web",
    "start": "node --env-file-if-exists=.env node_modules/next/dist/bin/next start apps/web",
    "worker": "node --import tsx apps/worker/main.ts",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "node --import tsx --test tests/*.e2e.mjs",
    "test:restore": "node --import tsx scripts/test-restore.mjs",
    "test:dispatch-load": "node scripts/with-test-database.mjs load",
    "lint": "eslint scripts tests *.mjs --max-warnings=0 && node scripts/lint-typescript.mjs",
    "build:release": "npm run build && npm run build:runtime && node scripts/prepare-release.mjs",
    "start:release": "node release/dist/web.mjs",
    "worker:release": "node release/dist/worker.mjs",
    "contracts:generate": "node --import tsx scripts/api-contracts.mjs --write",
    "contracts:check": "node --import tsx scripts/api-contracts.mjs",
    "security:check": "node scripts/check-secrets.mjs",
    "licenses": "node scripts/licenses.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run contracts:check && npm run security:check",
    "test:migrations": "node scripts/test-migrations.mjs",
    "test:audit": "node scripts/with-test-database.mjs audit",
    "test:release": "node scripts/test-release.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "test:containers": "node scripts/test-containers.mjs"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.25",
    "@js-temporal/polyfill": "0.5.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.25",
    "csv-parse": "7.0.3",
    "dotenv": "18.0.10",
    "next": "16.4.6",
    "nodemailer": "10.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.38.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "17.4.0",
    "prisma": "7.10.1",
    "smtp-server": "3.21.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
