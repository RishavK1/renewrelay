{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "paths": { "@server/*": ["./apps/web/server/*"], "@renewrelay/*": ["./packages/*"] },
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "tests/**/*.ts", "prisma.config.ts"],
  "exclude": ["**/node_modules", "**/.next"]
}
