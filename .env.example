RENEWRELAY_ENV=local
# Development only. Generate both secrets before starting the app.
MIGRATION_DATABASE_URL=postgresql://renewrelay_migrator:local_migrator@127.0.0.1:5432/renewrelay
DATABASE_URL=postgresql://renewrelay_app:local_app@127.0.0.1:5432/renewrelay
AUTH_DATABASE_URL=postgresql://renewrelay_auth:local_auth@127.0.0.1:5432/renewrelay
WORKER_DATABASE_URL=postgresql://renewrelay_worker:local_worker@127.0.0.1:5432/renewrelay
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
INVITE_ENCRYPTION_KEY=
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=renewrelay@example.test
WORKER_POLL_MS=1000
# Budget all replicas and identity mail against the actual provider account limit.
WORKER_MAIL_RATE_PER_SECOND=2
WORKER_MAIL_CONCURRENCY=4
WORKER_MAIL_BATCH_SIZE=200

# Optional production decision/reminder transport and signed provider events.
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=
OUTBOUND_MAIL_ENABLED=true

# Platform subscriptions. Leave disabled until the merchant and sandbox checks pass.
RAZORPAY_BILLING_ENABLED=false
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_PLAN_ID=
RAZORPAY_PLAN_AMOUNT_MINOR=149900
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
# Operational data purge is opt-in after the retention procedure is configured.
WORKSPACE_PURGE_ENABLED=false

# Never enable provider debug output. Set RENEWRELAY_ENV=production in the production deployment.
RESEND_DEBUG=false
